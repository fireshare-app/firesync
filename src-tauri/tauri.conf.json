{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Firesync",
  "version": "0.1.5",
  "identifier": "app.fireshare.firesync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Firesync",
        "width": 1120,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "label": "main"
      },
      {
        "label": "tray",
        "url": "index.html",
        "width": 320,
        "height": 338,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ5MEVCM0QwNzVFOEE1RgpSV1JmaWw0SFBldVFCTXNuVnlPYmYxRElKMzVMdmE4WUd4V3BTS1NySXVkVm1LVURxenUyZlM4aQo=",
      "endpoints": [
        "https://github.com/fireshare-app/firesync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
